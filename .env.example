# Neon Postgres connection string. Create a project at https://neon.tech
DATABASE_URL=

# The public URL this app is served from. Used by better-auth for cookies,
# redirects and building the admin-invite links sent by email.
# Example (dev): http://localhost:3000
# Example (prod): https://your-domain.com
BETTER_AUTH_URL=

# Random secret used to sign sessions. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Comma-separated list of email addresses that are automatically promoted to
# "super admin" the moment they register (or next sign in). A super admin can
# invite additional admins from /admin/team. You need at least one of these
# to bootstrap the app — set it, then register a normal account with that
# exact email.
SUPER_ADMIN_EMAILS=

# Vercel Blob read/write token. Used for opportunity images uploaded from the
# admin panel AND for the documents chefs upload during onboarding (CV, HACCP
# certificate, passport...). Create a Blob store in your Vercel project (Storage
# tab), connect it to the project, then run `vercel env pull .env.local`.
# Without it chefs cannot complete any upload question, so onboarding is blocked.
BLOB_READ_WRITE_TOKEN=

# Required for the emails the app sends (Resend, https://resend.com): admin
# invitations and the approved/rejected notice a chef gets after their application
# is reviewed. Without these the invite or the decision is still saved, but the
# email fails and the admin is told to check this config.
RESEND_API_KEY=
# Must be an address on a domain you have verified in your Resend dashboard.
RESEND_FROM_EMAIL=
